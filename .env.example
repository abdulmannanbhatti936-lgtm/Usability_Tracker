# Server
PORT=4000

# Admin token — change this in production!
ADMIN_TOKEN=change-me-super-secret

# Database path (relative to project root)
DB_PATH=./data/usability.db

# Data retention in days (older data is purged daily)
RETENTION_DAYS=90

# HMAC secret for short-lived heatmap tokens
HMAC_SECRET=change-me-hmac-secret-32-chars-min

# Restrict admin API to specific origin (optional, for production)
# ADMIN_ORIGIN=https://yourdomain.com
